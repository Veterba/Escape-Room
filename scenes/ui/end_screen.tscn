[node name="Subtitle" type="Label" parent="Center/Panel/Items"]
layout_mode = 2
text = "Secret code"
horizontal_alignment = 1

[node name="Code" type="Label" parent="Center/Panel/Items"]
layout_mode = 2
theme_override_colors/font_color = Color(0.247, 0.757, 0.69, 1)
theme_override_font_sizes/font_size = 48
text = "0000"
