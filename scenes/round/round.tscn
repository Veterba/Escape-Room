[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/round/round.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="2_player"]
[ext_resource type="Script" path="res://scripts/round/round_timer.gd" id="3_timer"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="4_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/pause_menu.tscn" id="5_pause"]
[ext_resource type="PackedScene" path="res://scenes/ui/end_screen.tscn" id="6_end"]
[ext_resource type="PackedScene" path="res://scenes/ui/debug_overlay.tscn" id="7_debug"]

[node name="Round" type="Node2D"]
script = ExtResource("1_script")

[node name="Player" parent="." instance=ExtResource("2_player")]

[node name="RoundTimer" type="Node" parent="."]
script = ExtResource("3_timer")

[node name="HUD" parent="." instance=ExtResource("4_hud")]

[node name="PauseMenu" parent="." instance=ExtResource("5_pause")]

[node name="EndScreen" parent="." instance=ExtResource("6_end")]

[node name="DebugOverlay" parent="." instance=ExtResource("7_debug")]
