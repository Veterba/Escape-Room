; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Escape Boom"
config/version="0.10.0"
run/main_scene="res://scenes/ui/password_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Config="*res://scripts/autoload/config.gd"
Audio="*res://scripts/autoload/audio.gd"
Events="*res://scripts/autoload/events.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
theme/custom="res://scenes/ui/theme.tres"

